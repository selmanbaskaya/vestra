        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her fiyat tarihiyle birlikte kaydedilir. Geçmiş dönem raporları o tarihte kayıtlı fiyatı kullanmaya devam eder."
          }
        }
      }
    },
